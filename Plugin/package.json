{
  "name": "beav",
  "private": true,
  "version": "2.7.10",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "scripts": {
    "build": "node scripts/sync-manifest-version.mjs && node scripts/build.mjs",
    "verify": "node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm build && pnpm verify && pnpm typecheck && pnpm test:desktop-bridge-client && pnpm test:site-research && pnpm test:generic-capture && pnpm test:plugin-diagnostics",
    "install:native-host": "node install-native-host.mjs",
    "diagnose:browser-control": "node scripts/diagnose-browser-control.mjs",
    "test:browser-control-faults": "node scripts/test-browser-control-faults.mjs",
    "test:browser-control-binding": "node scripts/test-browser-control-binding.mjs",
    "test:browser-session-kernel": "node scripts/test-browser-session-kernel.mjs",
    "test:cdp-transport-queue": "node scripts/test-cdp-transport-queue.mjs",
    "test:browser-protocol-compat": "node scripts/test-browser-protocol-compat.mjs",
    "test:content-runtime-lifecycle": "node scripts/test-content-runtime-lifecycle.mjs",
    "test:browser-client-locator": "node scripts/test-browser-client-locator.mjs",
    "test:locator-ast-runtime": "node scripts/test-locator-ast-runtime.mjs",
    "test:frame-topology-diagnostics": "node scripts/test-frame-topology-diagnostics.mjs",
    "test:cdp-event-replay": "node scripts/test-cdp-event-replay.mjs",
    "test:cdp-policy-classification": "node scripts/test-cdp-policy-classification.mjs",
    "test:desktop-bridge-client": "node scripts/test-desktop-bridge-client.mjs",
    "test:plugin-diagnostics": "node scripts/test-plugin-diagnostics.mjs",
    "test:site-research": "node --test scripts/test-site-research-runtime.mjs",
    "test:generic-capture": "node --test scripts/test-generic-capture.mjs",
    "smoke:browser-control": "node scripts/smoke-browser-control-e2e.mjs",
    "mcp:server": "node mcp-server.mjs",
    "agent:call": "node agent-client.mjs",
    "package": "zsh ./package-plugin.sh"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "linkedom": "0.18.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "defuddle": "0.19.2",
    "dompurify": "3.4.12"
  }
}
